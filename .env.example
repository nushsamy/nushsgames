# Root-level reference only: each app loads its own .env from its own directory
# (apps/spelling-bee/.env, apps/murder-mystery-voter/.env) using its own plain
# DATABASE_URL/PORT/etc. names — see that app's .env.example for what it actually
# reads. This file just shows both apps' variables side by side for onboarding;
# nothing in the repo loads this file directly.

# --- apps/auth ---
# Shared identity service: owns the one `users` table both apps below log in against.
# JWT_SECRET here must match JWT_SECRET_SPELLING_BEE and JWT_SECRET_MURDER_MYSTERY_VOTER,
# since those two only verify tokens (locally, no DB call) rather than mint them.
DATABASE_URL_AUTH="postgresql://nushsgames_auth:nushsgames_auth@localhost:5436/auth_dev?schema=public"
TEST_DATABASE_URL_AUTH="postgresql://nushsgames_auth:nushsgames_auth@localhost:5437/auth_test?schema=public"
JWT_SECRET_AUTH=change-me-in-production
FRONTEND_URLS_AUTH=http://localhost:5173,http://localhost:5174
PORT_AUTH=5002

# --- apps/spelling-bee ---
DATABASE_URL_SPELLING_BEE="postgresql://spelling_bee:spelling_bee@localhost:5432/spelling_bee_dev?schema=public"
TEST_DATABASE_URL_SPELLING_BEE="postgresql://spelling_bee:spelling_bee@localhost:5433/spelling_bee_test?schema=public"
JWT_SECRET_SPELLING_BEE=change-me-in-production
FRONTEND_URL_SPELLING_BEE=http://localhost:5173
PORT_SPELLING_BEE=5000

# --- apps/murder-mystery-voter ---
DATABASE_URL_MURDER_MYSTERY_VOTER="postgresql://murder_mystery:murder_mystery@localhost:5434/murder_mystery_voter_dev?schema=public"
TEST_DATABASE_URL_MURDER_MYSTERY_VOTER="postgresql://murder_mystery:murder_mystery@localhost:5435/murder_mystery_voter_test?schema=public"
JWT_SECRET_MURDER_MYSTERY_VOTER=change-me-in-production
FRONTEND_URL_MURDER_MYSTERY_VOTER=http://localhost:5174
PORT_MURDER_MYSTERY_VOTER=5001
RESEND_API_KEY_MURDER_MYSTERY_VOTER=re_your_key_here
EMAIL_FROM_MURDER_MYSTERY_VOTER="Murder Mystery Voter <mysteries@yourdomain.com>"

NODE_ENV=development
