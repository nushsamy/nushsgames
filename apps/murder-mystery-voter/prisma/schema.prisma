// Prisma schema for the murder mystery voter game logic layer.
// See prisma.config.ts for datasource url / migrations path configuration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  created
  in_progress
  completed
}

enum RoundStatus {
  pending
  open
  closed
}

enum BallotStatus {
  pending
  cast
  expired
}

model MysteryEvent {
  id           Int         @id @default(autoincrement())
  // References a user in the shared @nushsgames/auth service's database — no local FK,
  // since that table lives in a separate database now.
  userId       Int
  title        String
  status       EventStatus @default(created)
  totalRounds  Int         @default(0)
  currentRound Int         @default(0)
  createdAt    DateTime    @default(now())

  participants MysteryParticipant[]
  rounds       MysteryRound[]

  @@index([userId])
  @@map("mystery_events")
}

// A participant is both the real person voting and a possible suspect other participants can
// accuse -- characterName/description are the in-game persona; name/email are how the host and
// the email system reach the real person. There's no separate "suspect" entity: every participant
// is a candidate in every round (see roundLifecycleService/ballotService, which treat "this
// event's participants" as the suspect list for any round rather than storing it per round).
model MysteryParticipant {
  id            Int          @id @default(autoincrement())
  eventId       Int
  event         MysteryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  email         String
  characterName String
  description   String?
  isAttending   Boolean      @default(true)

  ballotsCast     Ballot[] @relation("BallotVoter")
  ballotsReceived Ballot[] @relation("BallotSuspect")

  @@unique([eventId, email])
  @@unique([eventId, characterName])
  @@index([eventId])
  @@map("mystery_participants")
}

model MysteryRound {
  id          String      @id @default(uuid())
  eventId     Int
  event       MysteryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roundNumber Int
  status      RoundStatus @default(pending)

  ballots Ballot[]

  @@unique([eventId, roundNumber])
  @@index([eventId])
  @@map("mystery_rounds")
}

model Ballot {
  id             String             @id @default(uuid())
  roundId        String
  round          MysteryRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId  Int
  participant    MysteryParticipant @relation("BallotVoter", fields: [participantId], references: [id], onDelete: Cascade)
  token          String             @unique
  status         BallotStatus       @default(pending)
  votedSuspectId Int?
  votedSuspect   MysteryParticipant? @relation("BallotSuspect", fields: [votedSuspectId], references: [id])
  createdAt      DateTime           @default(now())
  castAt         DateTime?
  emailError     String?

  @@unique([roundId, participantId])
  @@index([roundId])
  @@map("ballots")
}
