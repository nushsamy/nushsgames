DATABASE_URL="postgresql://nushsgames_auth:nushsgames_auth@localhost:5436/auth_dev?schema=public"
TEST_DATABASE_URL="postgresql://nushsgames_auth:nushsgames_auth@localhost:5437/auth_test?schema=public"
NODE_ENV=development
PORT=5002
JWT_SECRET=change-me-in-production
# Must match the JWT_SECRET used by apps/spelling-bee and apps/murder-mystery-voter — they
# verify tokens this service issues, so the secret has to line up across all three.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174
# Optional. Leave unset for local dev (cookie defaults to host-only "localhost", which every
# app here runs on regardless of port). In production, set this to the shared parent domain
# (e.g. ".nushsgames.com") so the session cookie is shared across each app's subdomain.
COOKIE_DOMAIN=
